      "timeout_s": 240,
      "answer": "{\"code\":\"function reconcile(events) {\\n  var RANK = { queued: 0, sent: 1, failed: 2, delivered: 3, read: 4 };\\n  var out = [];\\n  if (!Array.isArray(events)) return out;\\n  var byCompany = new Map();\\n  for (var i = 0; i < events.length; i++) {\\n    var e = events[i];\\n    if (e === null || typeof e !== 'object' || Array.isArray(e)) continue;\\n    var company = e.company;\\n    var id = e.id;\\n    var status = e.status;\\n    var at = e.at;\\n    if (typeof company !== 'string' || company.length === 0) continue;\\n    if (typeof id !== 'string' || id.length === 0) continue;\\n    if (typeof status !== 'string') continue;\\n    if (!Object.prototype.hasOwnProperty.call(RANK, status)) continue;\\n    if (typeof at !== 'number' || !Number.isInteger(at) || at < 0) continue;\\n    var ids = byCompany.get(company);\\n    if (ids === undefined) {\\n      ids = new Map();\\n      byCompany.set(company, ids);\\n    }\\n    var cur = ids.get(id);\\n    if (cur === undefined) {\\n      ids.set(id, { company: company, id: id, status: status, at: at });\\n      continue;\\n    }\\n    var curRank = RANK[cur.status];\\n    var newRank = RANK[status];\\n    if (newRank > curRank) {\\n      cur.status = status;\\n      cur.at = at;\\n    } else if (newRank === curRank && at > cur.at) {\\n      cur.at = at;\\n    }\\n  }\\n  var companies = [];\\n  byCompany.forEach(function (v, k) { companies.push(k); });\\n  companies.sort(function (a, b) { return a < b ? -1 : a > b ? 1 : 0; });\\n  for (var c = 0; c < companies.length; c++) {\\n    var map = byCompany.get(companies[c]);\\n    var keys = [];\\n    map.forEach(function (v, k) { keys.push(k); });\\n    keys.sort(function (a, b) { return a < b ? -1 : a > b ? 1 : 0; });\\n    for (var j = 0; j < keys.length; j++) {\\n      var r = map.get(keys[j]);\\n      out.push({ company: r.company, id: r.id, status: r.status, at: r.at });\\n    }\\n  }\\n  return out;\\n}\"}",
